# Chat do Assistente de Investimentos (só no servidor; nunca no navegador)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Dados da B3 (opcional): sem ele, Ibovespa e maiores altas/baixas ficam escondidos
BRAPI_TOKEN=

# Criptografia em repouso. Nasce desligada. Não ligue sem ler server/cripto.ts.
# A chave tem 32 bytes em base64 e fica SÓ na Vercel (nunca numa variável VITE_).
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# ENCRYPTION_AT_REST=true
# FIELD_ENCRYPTION_KEY=

# Acesso pago. Sem ACESSO_MODO=convite o app continua aberto (não tranca quem já usa).
# Com convite, rotas de IA, fatura e o WhatsApp consultam a tabela acessos.
# ACESSO_MODO=convite
# ACESSO_CORTE=2026-12-31T23:59:59Z
# ACESSO_NOVOS_DESDE=
# CAKTO_WEBHOOK_SECRET=
# Segredo do painel do dono e da fila (nunca no navegador)
# ADMIN_SECRET=

# Métricas (opcional). Sem estes IDs, nada é carregado.
# VITE_PLAUSIBLE_DOMAIN=
# VITE_META_PIXEL_ID=
