{
  "rewrites": [
    {
      "source": "/api/fila",
      "destination": "/api/admin?rota=fila"
    },
    {
      "source": "/api/cakto",
      "destination": "/api/admin?rota=cakto"
    },
    {
      "source": "/api/acesso",
      "destination": "/api/admin?rota=acesso"
    },
    {
      "source": "/guias",
      "destination": "/guias/index.html"
    },
    {
      "source": "/guias/:slug",
      "destination": "/guias/:slug/index.html"
    },
    {
      "source": "/ferramentas/:slug",
      "destination": "/ferramentas/:slug/index.html"
    },
    {
      "source": "/planos",
      "destination": "/planos/index.html"
    },
    {
      "source": "/politica-de-privacidade",
      "destination": "/politica-de-privacidade/index.html"
    },
    {
      "source": "/termos-de-uso",
      "destination": "/termos-de-uso/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(sw.js|manifest.webmanifest|favicon[^/]*|icon-[^/]*|apple-touch-icon[^/]*|logo-[^/]*|moeda.svg|og-image.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' https://plausible.io https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://www.facebook.com https://connect.facebook.net; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://plausible.io https://www.facebook.com https://connect.facebook.net; frame-ancestors 'self'; worker-src 'self' blob:; media-src 'self' blob:"
        }
      ]
    }
  ],
  "functions": {
    "api/fatura.ts": {
      "maxDuration": 60
    },
    "api/whatsapp.ts": {
      "maxDuration": 60
    },
    "api/resumo.ts": {
      "maxDuration": 60
    },
    "api/conselheiro.ts": {
      "maxDuration": 60
    },
    "api/admin.ts": {
      "maxDuration": 60
    },
    "api/investimentos/chat.ts": {
      "maxDuration": 60
    },
    "api/mercado.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/lembretes",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/resumo",
      "schedule": "0 13 * * *"
    }
  ]
}